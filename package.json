{
  "name": "team-cli",
  "version": "1.0.0",
  "description": "Git-backed team rule and skill manager",
  "type": "module",
  "bin": {
    "team-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "agents": "tsx src/cli.ts",
    "hooks:install": "node -e \"require('node:fs').chmodSync('.githooks/pre-commit', 0o755)\" && git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/semver": "^7.5.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.12.0"
}
