{
  "name": "@icc-grow/team-cli",
  "version": "1.0.0",
  "description": "Git-backed team rule and skill manager",
  "keywords": [
    "cli",
    "team",
    "rules",
    "skills",
    "codex"
  ],
  "homepage": "https://github.com/GreatHonour/ai-rules#readme",
  "bugs": {
    "url": "https://github.com/GreatHonour/ai-rules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreatHonour/ai-rules.git"
  },
  "type": "module",
  "bin": {
    "team-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "agents": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm format:check && pnpm test && pnpm check",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.17"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.0",
    "commander": "^14.0.0",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.3.1",
    "@types/semver": "^7.5.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.12.0"
}
